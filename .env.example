# Copy to .env and fill in ONE key. Without a key the dashboard and purchase planner still work;
# only "Describe your stock" and "Ask StockWise" need the AI assistant.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional. Defaults: anthropic/claude-sonnet-5.5 (OpenRouter) or claude-sonnet-5-5 (Anthropic).
AI_MODEL=
