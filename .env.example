# Copy to .env and fill in ONE key. Without a key the dashboard and purchase planner still work;
# only "Describe your stock" and "Ask StockWise" need the AI assistant.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional. Defaults: openrouter/free (OpenRouter picks a free model) or claude-sonnet-5-5 (Anthropic).
# With OpenRouter credit you can use Claude instead, e.g. AI_MODEL=anthropic/claude-sonnet-5.5
AI_MODEL=
